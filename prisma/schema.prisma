// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgres"
  // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
  // Further reading:
  // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
  // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

// Necessary for Next auth
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String             @id @default(cuid())
  name          String?
  email         String?            @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  password      String?
  tradeLogs     TradeHistory[]
  tags          Tag[]
  tradeTags     TradeTagRelation[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model TradeHistory {
  id             Int           @id @default(autoincrement())
  Symbol         String
  TimeStamp      DateTime
  userId         String
  Volume         Float
  Price          Float
  Profit         Float
  tradeDetails   TradeDetails? @relation(fields: [tradeDetailsId], references: [id])
  tradeDetailsId Int?
  user           User          @relation(fields: [userId], references: [id])

  @@unique([Symbol, TimeStamp, userId])
}

model Tag {
  id        Int                @id @default(autoincrement())
  name      String
  type      String
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  tradeTags TradeTagRelation[]

  @@unique([name, userId])
}

model TradeTagRelation {
  id      Int    @id @default(autoincrement())
  tagId   Int
  symbol  String
  date    String
  userId  String
  tradeId Int

  tag          Tag          @relation(fields: [tagId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  tradeDetails TradeDetails @relation(fields: [tradeId], references: [id])

  @@unique([tagId, symbol, date, userId])
}

model TradeDetails {
  id           Int                @id @default(autoincrement())
  symbol       String
  date         String
  tradeHistory TradeHistory[]
  rating       Int?
  notes        String?            @db.Text
  tradeTags    TradeTagRelation[]
}
